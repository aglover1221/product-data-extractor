# Path the viewer reads product data from. Resolved relative to the project
# root (where you run `npm run dev`). Default: `data/sample` — the tiny
# sample dataset shipped with the repo.
#
# Point this at a real knowledgebase directory laid out as:
#   {DATA_ROOT}/{category}/{vendor}/{product-line}/{slug}/{slug}.md
#   {DATA_ROOT}/{category}/{vendor}/{product-line}/{slug}/extraction.json
#   {DATA_ROOT}/schemas/{category}.md
#   {DATA_ROOT}/schemas/overlays/*.md
#
# Examples:
#   DATA_ROOT=data/sample          # the shipped sample (default)
#   DATA_ROOT=../my-product-data   # a sibling repo with your own data
#   DATA_ROOT=/abs/path/to/data    # an absolute path
DATA_ROOT=data/sample
